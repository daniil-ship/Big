// fib.bg — рекурсия и функции
// Показывает, что Big поддерживает функции с параметрами
// В bootstrap v0.1 пользовательские функции компилируются как заглушки;
// полная поддержка рекурсии будет в v0.2. Но парсер и проверка типов уже работают.

func fib(n: i32) -> i32 {
    if n <= 1 {
        return n;
    }
    // рекурсия: fib(n-1) + fib(n-2)
    // В bootstrap это пока не генерирует машинный код, но парсится и проверяется
    return fib(n - 1) + fib(n - 2);
}

func main() -> i32 {
    let r: i32 = fib(10);
    print("fib(10) = ");
    print(r);
    println("");
    return 0;
}
